# Токен бота от @BotFather
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot) — сюда приходят заявки
ADMIN_ID=
# Необязательно: ключ Claude API для режима «умный ответ». Пусто = режим выключен.
ANTHROPIC_API_KEY=
# Модель для умного ответа (по умолчанию claude-opus-5-5; дешевле — claude-haiku-5-5)
CLAUDE_MODEL=claude-opus-5-5
DB_PATH=shop.db
LOG_LEVEL=INFO
